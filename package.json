{
  "name": "brickmotion-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup-data.ts",
    "setup:shadow": "tsx scripts/import-shadow-metadata.ts",
    "test:v4": "vitest run tests/anim/standardMotionV4.test.ts",
    "verify:v4:offline": "node scripts/verify-v4-offline.cjs",
    "verify:v4:helicopter:offline": "node scripts/verify-v4-helicopter-offline.cjs",
    "test:v4:mechanisms": "vitest run tests/anim/standardMotionV4Mechanisms.test.ts",
    "verify:v4:mechanisms:offline": "node scripts/verify-v4-mechanisms-offline.cjs",
    "test:v4:collision-autodetect": "vitest run tests/anim/standardMotionV4AutoCollision.test.ts",
    "verify:v4:collision-autodetect:offline": "node scripts/verify-v4-enhancement-offline.cjs",
    "typecheck:v4:collision-autodetect:offline": "node scripts/check-v4-enhancement-types.cjs",
    "audit:v4:5590": "node scripts/audit-v4-5590-mechanics.cjs",
    "test:scene": "vitest run tests/render/sceneSetup.test.ts",
    "verify:scene:offline": "node scripts/verify-scene-studio-offline.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "idb-keyval": "^6.3.0",
    "mediabunny": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
